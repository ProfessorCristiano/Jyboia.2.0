# ==========================================
# Exemplo 2: Cálculo de Média Escolar (.jy)
# ==========================================

aluno = "Maria Silva"
nota1 = 8.5
nota2 = 7.0
nota3 = 9.0

media = (nota1 + nota2 + nota3) / 3

escreva("Aluno:", aluno)
escreva("Média final:", media)

se media >= 7.0:
    situacao = "Aprovado(a)!"
senaose media >= 5.0:
    situacao = "Em Recuperacao!"
senao:
    situacao = "Reprovado(a)!"

escreva("Situação:", situacao)
